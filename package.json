{
  "name": "shanghai-1976-force-map-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "preview": "remotion studio src/index.ts",
    "render": "npm run validate && remotion render src/index.ts Shanghai1976 output/shanghai-1976-force-map.mp4",
    "simulate:counterfactual": "python scripts/simulate_shanghai_counterfactual.py",
    "render:counterfactual": "npm run simulate:counterfactual && npm run typecheck && remotion render src/index.ts Shanghai1976Counterfactual output/shanghai-1976-counterfactual-silent.mp4",
    "music:counterfactual": "uv run --project ../ai-tools/ACE-Step-1.5 python scripts/generate_counterfactual_score.py",
    "still": "remotion still src/index.ts Shanghai1976",
    "validate": "node scripts/validate-data.mjs",
    "typecheck": "tsc --noEmit",
    "hybrid:prepare": "python scripts/prepare_generative_inputs.py",
    "hybrid:dry-run": "python scripts/runway_dual_generate.py",
    "hybrid:submit": "python scripts/runway_dual_generate.py --submit",
    "hybrid:resume": "python scripts/runway_dual_generate.py --resume",
    "hybrid:composite": "python scripts/composite_hybrid.py",
    "music:validate": "python scripts/run_music_pipeline.py --validate-only",
    "music:generate": "python scripts/run_music_pipeline.py",
    "music:generate:ace": "uv run --project ../ai-tools/ACE-Step-1.5 python scripts/generate_music_acestep.py",
    "music:generate:battle-c": "uv run --project ../ai-tools/ACE-Step-1.5 python scripts/generate_music_acestep.py --profile battle-c --count 4",
    "music:generate:historical-crisis": "uv run --project ../ai-tools/ACE-Step-1.5 python scripts/generate_music_acestep.py --profile historical-crisis --duration 90 --count 4 --output-name candidates-historical-crisis-90",
    "music:generate:historical-dread": "uv run --project ../ai-tools/ACE-Step-1.5 python scripts/generate_music_acestep.py --profile historical-dread --duration 90 --count 4 --seed 19761010 --seed 19761011 --seed 19761012 --seed 19761013 --output-name candidates-historical-dread-90",
    "music:conform:historical-dread": "python scripts/conform_battle_c.py --duration 90 --output-dir output/music/candidates-historical-dread-90-conformed output/music/candidates-historical-dread-90/ace-v15-historical-dread-*.flac",
    "music:score:historical-dread": "python scripts/score_battle_c.py --report output/music/historical-dread-90-ranking.json output/music/candidates-historical-dread-90-conformed/ace-v15-historical-dread-*.flac",
    "music:semantic:historical-dread": "python scripts/score_music_semantics.py --report output/music/historical-dread-90-semantic.json output/music/candidates-historical-dread-90-conformed/ace-v15-historical-dread-01-conformed.flac output/music/candidates-historical-dread-90-conformed/ace-v15-historical-dread-02-conformed.flac output/music/candidates-historical-dread-90-conformed/ace-v15-historical-dread-03-conformed.flac output/music/candidates-historical-dread-90-conformed/ace-v15-historical-dread-04-conformed.flac",
    "music:generate:historical-dread-atonal": "uv run --project ../ai-tools/ACE-Step-1.5 python scripts/generate_music_acestep.py --profile historical-dread-atonal --duration 90 --count 4 --seed 19761014 --seed 19761015 --seed 19761016 --seed 19761017 --output-name candidates-historical-dread-atonal-90",
    "music:conform:historical-dread-atonal": "python scripts/conform_battle_c.py --duration 90 --output-dir output/music/candidates-historical-dread-atonal-90-conformed output/music/candidates-historical-dread-atonal-90/ace-v15-historical-dread-atonal-*.flac",
    "music:score:historical-dread-atonal": "python scripts/score_battle_c.py --report output/music/historical-dread-atonal-90-ranking.json output/music/candidates-historical-dread-atonal-90-conformed/ace-v15-historical-dread-atonal-*.flac",
    "music:semantic:historical-dread-atonal": "python scripts/score_music_semantics.py --report output/music/historical-dread-atonal-90-semantic.json output/music/candidates-historical-dread-atonal-90-conformed/ace-v15-historical-dread-atonal-01-conformed.flac output/music/candidates-historical-dread-atonal-90-conformed/ace-v15-historical-dread-atonal-02-conformed.flac output/music/candidates-historical-dread-atonal-90-conformed/ace-v15-historical-dread-atonal-03-conformed.flac output/music/candidates-historical-dread-atonal-90-conformed/ace-v15-historical-dread-atonal-04-conformed.flac",
    "music:generate:historical-resistance": "uv run --project ../ai-tools/ACE-Step-1.5 python scripts/generate_music_acestep.py --profile historical-resistance --duration 90 --count 4 --seed 19761022 --seed 19761023 --seed 19761024 --seed 19761025 --output-name candidates-historical-resistance-v2-90",
    "music:conform:historical-resistance": "python scripts/conform_battle_c.py --duration 90 --output-dir output/music/candidates-historical-resistance-v2-90-conformed output/music/candidates-historical-resistance-v2-90/ace-v15-historical-resistance-*.flac",
    "music:score:historical-resistance": "python scripts/score_battle_c.py --report output/music/historical-resistance-v2-90-ranking.json output/music/candidates-historical-resistance-v2-90-conformed/ace-v15-historical-resistance-*.flac",
    "music:semantic:historical-resistance": "python scripts/score_music_semantics.py --mode resistance --report output/music/historical-resistance-v2-90-semantic.json output/music/candidates-historical-resistance-v2-90-conformed/ace-v15-historical-resistance-01-conformed.flac output/music/candidates-historical-resistance-v2-90-conformed/ace-v15-historical-resistance-02-conformed.flac output/music/candidates-historical-resistance-v2-90-conformed/ace-v15-historical-resistance-03-conformed.flac output/music/candidates-historical-resistance-v2-90-conformed/ace-v15-historical-resistance-04-conformed.flac",
    "release:mux:historical-dread": "python scripts/master_and_mux.py output/music/historical-dread-atonal-90-selected.flac --output output/shanghai-1976-historical-dread-review.mp4 --master output/music/shanghai-1976-historical-dread-master.wav --report output/historical-dread-mux-validation.json",
    "release:validate:historical-dread": "python scripts/validate_release.py output/shanghai-1976-historical-dread-review.mp4 --report output/historical-dread-validation.json --keyframes output/historical-dread-keyframes",
    "music:compose:historical-resistance": "python scripts/compose_resistance_midi.py",
    "music:compose:imminent-confrontation": "python scripts/render_sso_confrontation_score.py",
    "release:mux:imminent-confrontation": "python scripts/master_and_mux.py output/music/shanghai-1976-imminent-confrontation-90.wav --output output/shanghai-1976-imminent-confrontation-review.mp4 --master output/music/shanghai-1976-imminent-confrontation-master.wav --report output/imminent-confrontation-mux-validation.json",
    "release:validate:imminent-confrontation": "python scripts/validate_release.py output/shanghai-1976-imminent-confrontation-review.mp4 --report output/imminent-confrontation-validation.json --keyframes output/imminent-confrontation-keyframes",
    "music:generate:map-chronicle": "uv run --project ../ai-tools/ACE-Step-1.5 python scripts/generate_map_chronicle_dual_cues.py",
    "release:mux:map-chronicle": "python scripts/master_and_mux.py output/music/shanghai-1976-map-chronicle-90.wav --output output/shanghai-1976-map-chronicle-review.mp4 --master output/music/shanghai-1976-map-chronicle-master.wav --report output/map-chronicle-mux-validation.json",
    "release:validate:map-chronicle": "python scripts/validate_release.py output/shanghai-1976-map-chronicle-review.mp4 --report output/map-chronicle-validation.json --keyframes output/map-chronicle-keyframes",
    "release:mux:historical-resistance": "python scripts/master_and_mux.py output/music/historical-resistance-deterministic-v4.flac --output output/shanghai-1976-resistance-review.mp4 --master output/music/shanghai-1976-resistance-master.wav --report output/historical-resistance-mux-validation.json",
    "release:validate:historical-resistance": "python scripts/validate_release.py output/shanghai-1976-resistance-review.mp4 --report output/historical-resistance-validation.json --keyframes output/historical-resistance-keyframes",
    "music:conform:historical-crisis": "python scripts/conform_battle_c.py --duration 90 --output-dir output/music/candidates-historical-crisis-90-conformed output/music/candidates-historical-crisis-90/ace-v15-historical-crisis-*.flac",
    "music:score:historical-crisis": "python scripts/score_battle_c.py --report output/music/historical-crisis-90-ranking.json output/music/candidates-historical-crisis-90-conformed/ace-v15-historical-crisis-*-conformed.flac",
    "music:select:historical-crisis": "python scripts/select_top_music.py output/music/historical-crisis-90-ranking.json output/music/historical-crisis-90-selected.flac",
    "release:mux": "python scripts/master_and_mux.py output/music/historical-crisis-90-selected.flac",
    "release:validate": "python scripts/validate_release.py",
    "release:historical-crisis": "npm run validate && npm run typecheck && npm run music:generate:historical-crisis && npm run music:conform:historical-crisis && npm run music:score:historical-crisis && npm run music:select:historical-crisis && npm run render && npm run release:mux && npm run release:validate",
    "music:conform:battle-c": "python scripts/conform_battle_c.py output/music/candidates-battle-c/ace-v15-battle-c-*.flac",
    "music:score:battle-c": "python scripts/score_battle_c.py output/music/candidates-battle-c-conformed/ace-v15-battle-c-*-conformed.flac",
    "music:restore": ".venv-audio\\Scripts\\python.exe scripts/run_audio_restoration_pipeline.py",
    "music:restore:sonicmaster": ".venv-audio\\Scripts\\python.exe scripts/run_sonicmaster_space.py",
    "music:score:context": "python scripts/score_context_music.py output/music/candidates-storm-conformed/*.flac",
    "music:conform": "python scripts/conform_music_timeline.py output/music/candidates/ace-v15-candidate-02.flac",
    "music:master": "python scripts/master_and_mux.py output/music/shanghai-1976-score-conformed.flac",
    "narration:generate": "python scripts/run_contextual_tts_pipeline.py",
    "narration:mix": "python scripts/run_contextual_tts_pipeline.py --mix-only"
  },
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "@remotion/media": "4.0.540",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
